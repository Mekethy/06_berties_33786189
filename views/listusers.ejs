<!DOCTYPE html>
<html>
<head>
    <title>Registered Users</title>
</head>
<body>

    <h1>Registered Users</h1>

    <% if (users.length === 0) { %>
        <p>No users have registered yet.</p>
    <% } else { %>
        <ul>
            <% users.forEach(user => { %>
                <li>
                    <strong><%= user.username %></strong> —
                    <%= user.first %> <%= user.last %> —
                    <%= user.email %>
                </li>
            <% }) %>
        </ul>
    <% } %>

</body>
</html>
